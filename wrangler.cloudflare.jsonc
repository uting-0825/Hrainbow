{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiao-run-memory-room",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiao-run-memory-room",
      "database_id": "d6b07f56-78c8-454b-bf81-c740ac6c4f64",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
